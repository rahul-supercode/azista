# Copy this file to `.env.local` and fill in real values:
#   cp .env.example .env.local
#
# `.env.local` is git-ignored. Never commit real secrets.
#
# Variables prefixed with NEXT_PUBLIC_ are inlined into the client bundle at
# build time and are visible to anyone. Never put secrets in NEXT_PUBLIC_ vars.

# Public, canonical URL of the site (used for metadata, Open Graph, etc.)
# Required: the build fails without it. Use your dev server URL locally and
# the deployed domain (e.g. https://azista.space) on staging/production.
NEXT_PUBLIC_SITE_URL=
